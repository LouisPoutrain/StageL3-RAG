            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A novel multiplex PCR assay for individual identification in the vulnerable Chinese Egret (Egretta eulophotes) using molted feathers</rdf:li>
            </rdf:Alt>
